# ---------------------------------------------------------------------------
# Supabase (get these from your project: Settings -> API)
# ---------------------------------------------------------------------------
# Public URL + anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key: SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used for admin-only server actions (e.g. creating auth users, seeding).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Anthropic Claude API (SERVER ONLY — never exposed to the client)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key
# Model name is configurable so it can be swapped without code changes.
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
